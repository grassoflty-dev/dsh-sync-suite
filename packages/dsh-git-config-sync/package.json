{
  "name": "dsh-git-config-sync",
  "version": "1.0.0",
  "description": "DSH 跨设备配置同步：cordis patch 逐条合并、provider/插件清单/MCP、Git 快照、fail-closed 恢复",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./remote": "./dist/remote/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "keywords": ["dsh", "dsh-plugin", "config-sync", "git"],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
