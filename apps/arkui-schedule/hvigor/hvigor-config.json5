{
  "modelVersion": "26.0.0",
  "dependencies": {
  },
  "execution": {
    // 机器空闲时用全速；需要边用电脑边构建时，改用 tools/build-harmony.ps1 的 -Cores/-Priority 限速。
    "daemon": true,
    "parallel": true,
    "incremental": true,
    "analyze": "normal",
    "typeCheck": false
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {
    "maxOldSpaceSize": 4096
  }
}
