{
  "modelVersion": "26.0.0",
  "dependencies": {
  },
  "execution": {
    // 低占用模式：这台机器上并构建会让用户明显卡顿，因此默认关闭 daemon 与并行，
    // 并限制 hvigor 守护进程的堆上限。需要更快构建时再临时打开。
    "daemon": false,
    "parallel": false,
    "incremental": true,
    "analyze": "normal",
    "typeCheck": false
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {
    "maxOldSpaceSize": 2048
  }
}
