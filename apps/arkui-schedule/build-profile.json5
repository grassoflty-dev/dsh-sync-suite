// 平台装配（方案 b）：module → product 的映射必须按 target 分开，否则 `entry/build-profile.json5`
// 里 `android` target 的 `source.sourceRoots`（只含 ./src/main）不会被任何 product 用到，
// 鸿蒙构建就会解析到共享层默认的 `platformFeatures.ts` → `setPlatform('android')`、手写/OCR 全关。
//
// ⚠️ 未验证项：本机没有 DevEco Studio / hvigor，该装配是否被 DevEco 5 / ArkUI-X 采纳**未实测**；
// 验证步骤见 `reports/platformfix.md`。
{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "android",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "Android"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        },
        {
          "name": "android",
          "applyToProducts": [
            "android"
          ]
        }
      ]
    }
  ]
}
