// 平台装配：用 target 的 source.sourceRoots 区分构建输入。
//
// 为什么不是「单源码树」：`pages/Handwriting.ets` 一旦登记进共享 `main_pages.json`，ArkTS 编译就会把它
// 和静态 import 的 Canvas/OCR 模块带进 Android 产物；只靠动态 import() 也不行 —— ArkTS 编译器仍要解析
// 模块路径，`@kit.CoreVisionKit` / `reminderAgentManager` 在 Android 侧不存在会直接编译失败。
//
// 当前状态（2026-11-15 实测）：本机只装了纯 DevEco 26（无 ArkUI-X），因此这里只保留 HarmonyOS target
// （`src/main` + `src/harmony`，同名相对路径 harmony 覆盖 main）。Android target 的完整写法保存在
// `entry/build-profile.arkui-x.json5`，装上 ArkUI-X 工具链后连同根 `build-profile.arkui-x.json5` 一起启用。
{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      "runtimeOnly": {
        // 运行时不参与编译的源（保持空：手写/OCR 必须走 sourceRoots 隔离，不能用运行时注入绕过编译）
        "sources": []
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      // HarmonyOS 构建：共享层 + 鸿蒙覆盖层（override 语义：同名相对路径以 src/harmony 为准）
      "name": "default",
      "source": {
        "sourceRoots": [
          "./src/main",
          "./src/harmony"
        ]
      }
    }
  ]
}
