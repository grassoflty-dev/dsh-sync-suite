// 平台装配（方案 b）：用 target 的 source.sourceRoots 区分构建输入，而不是单源码树 + 运行时判断。
//
// 为什么不是「单源码树」：`pages/Handwriting.ets` 一旦登记进共享 `main_pages.json`，ArkTS 编译就会把它
// 和静态 import 的 Canvas/OCR 模块带进 Android 产物；只靠动态 import() 也不行 —— ArkTS 编译器仍要解析
// 模块路径，`@kit.CoreVisionKit` / `reminderAgentManager` 在 Android 侧不存在会直接编译失败。
// 因此必须让鸿蒙 target 的输入 = `src/main` + `src/harmony`（同名相对路径 harmony 覆盖 main），
// Android target 只有 `src/main`，Android 侧物理上拿不到 handwrite/OCR 代码。
//
// ⚠️ 未验证项：本机没有 DevEco Studio / hvigor，`source.sourceRoots` 是否被 DevEco 5 / ArkUI-X 的
// hvigor-ohos-plugin 采纳**尚未实测**（见 `reports/platformfix.md` 的验证步骤）。运行时检测
// （`common/platform.ts#detectPlatformFrom` + `devicePlatform.ets` 覆盖层）是第二道防线。
{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      "runtimeOnly": {
        // 运行时不参与编译的源（保持空：手写/OCR 必须走 sourceRoots 隔离，不能用运行时注入绕过编译）
        "sources": []
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      // HarmonyOS 构建：共享层 + 鸿蒙覆盖层（override 语义：同名相对路径以 src/harmony 为准）
      "name": "default",
      "source": {
        "sourceRoots": [
          "./src/main",
          "./src/harmony"
        ]
      }
    },
    {
      // Android 构建：只有共享层，物理上不编译 handwrite/OCR/PixelMap 代码
      "name": "android",
      "source": {
        "sourceRoots": [
          "./src/main"
        ]
      }
    }
  ]
}
